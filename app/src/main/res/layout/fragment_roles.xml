<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_fondo">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="263dp"
        android:layout_height="73dp"
        android:layout_marginBottom="44dp"
        android:fontFamily="serif"
        android:text="Selecciona tu rol para continuar"
        android:textAlignment="center"
        android:textColor="@color/blanco"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/administrador_boton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="337dp"
        android:layout_height="314dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/eco_market" />

    <Button
        android:id="@+id/administrador_boton"
        android:layout_width="223dp"
        android:layout_height="59dp"
        android:layout_marginBottom="132dp"
        android:backgroundTint="@color/blanco"
        android:fontFamily="serif"
        android:text="@string/admin"
        android:textAlignment="center"
        android:textColor="@color/negro"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/blanco"
        app:strokeWidth="3dp" />

    <Button
        android:id="@+id/usuriogeneral_boton"
        android:layout_width="223dp"
        android:layout_height="59dp"
        android:layout_marginBottom="56dp"
        android:backgroundTint="@color/verde_boton"
        android:fontFamily="serif"
        android:text="@string/usuario_general"
        android:textAlignment="center"
        android:textColor="@color/negro"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/administrador_boton"
        app:strokeColor="@color/verde_boton"
        app:strokeWidth="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>