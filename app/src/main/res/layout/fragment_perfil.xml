<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="254dp"
        android:layout_height="183dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/borde_peque"
        android:clipToOutline="true"
        android:contentDescription="@string/perfil_imagen_descripcion"
        android:elevation="6dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ecosinletra"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nombredeperfil"
        android:layout_width="406dp"
        android:layout_height="46dp"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="@string/nombre"
        android:textColor="@color/verde_fondo"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <TextView
        android:id="@+id/tv_nombre"
        style="@style/EditTextRounded"
        android:layout_width="299dp"
        android:layout_height="39dp"
        android:layout_marginTop="10dp"
        android:text="@string/perfil_nombre_completo"
        android:textAlignment="center"
        android:textColor="@color/negro"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nombredeperfil"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/tv_correo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/correo_electronico"
        android:textColor="@color/verde_fondo"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/tv_nombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tv_correodeperfil"
        style="@style/EditTextRounded"
        android:layout_width="301dp"
        android:layout_height="40dp"
        android:layout_marginTop="460dp"
        android:text="@string/perfil_correo_electronico"
        android:textAlignment="center"
        android:textColor="@color/negro"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/telefono_label"
        android:layout_width="409dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/telefono"
        android:textColor="@color/verde_fondo"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="529dp" />

    <TextView
        android:id="@+id/tv_telefono"
        style="@style/EditTextRounded"
        android:layout_width="307dp"
        android:layout_height="42dp"
        android:text="@string/perfil_numero_telefono"
        android:textAlignment="center"
        android:textColor="@color/negro"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.528"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/telefono_label"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/btn_editar"
        android:layout_width="203dp"
        android:layout_height="44dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/verde_fondo"
        android:text="@string/perfil_editar"
        android:textColor="@color/blanco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_telefono"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="TouchTargetSizeCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>
