<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroActivity"
    android:background="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_nombreapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/registrate"
            android:textAlignment="center"
            android:textColor="@color/verde_fondo"
            android:textSize="38dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_descripcion_registro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/descripcion_registro"
            android:layout_marginTop="20dp"
            android:textColor="@color/negro"
            android:gravity="center"/>

        <EditText
            android:id="@+id/editTextNombres"
            style="@style/EditTextRounded"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:ems="10"
            android:gravity="center"
            android:hint="nombres"
            android:inputType="text"
            android:textColorHint="@color/gris_letra" />

        <EditText
            android:id="@+id/editTextApellidos"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:ems="10"
            android:gravity="center"
            android:inputType="text"
            android:textColor="@color/negro"
            android:hint="apellidos"
            android:textColorHint="@color/gris_letra"
            style="@style/EditTextRounded" />

        <EditText
            android:id="@+id/editTextCorreo"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:ems="10"
            android:gravity="center"
            android:inputType="text"
            android:textColor="@color/negro"
            android:hint="correo_electronico"
            android:textColorHint="@color/gris_letra"
            style="@style/EditTextRounded" />

        <EditText
            android:id="@+id/editTextTelefono"
            android:hint="Telefono"
            style="@style/EditTextRounded" />

        <EditText
            android:id="@+id/editTextContrasena"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:ems="10"
            android:gravity="center"
            android:inputType="text"
            android:textColor="@color/negro"
            android:hint="contraseña"
            android:textColorHint="@color/gris_letra"
            style="@style/EditTextRounded" />

        <EditText
            android:id="@+id/editTextRepetirContrasena"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:ems="10"
            android:gravity="center"
            android:inputType="text"
            android:textColor="@color/negro"
            android:hint="repetir_contraseña"
            android:textColorHint="@color/gris_letra"
            style="@style/EditTextRounded" />

        <CheckBox
            android:id="@+id/terminosCondiciones"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:ems="10"
            android:gravity="center"
            android:text="terminos y condiciones"
            android:textColor="@color/negro"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/buttonRegistro"
            android:layout_width="278dp"
            android:layout_height="70dp"
            android:layout_marginTop="27dp"
            android:backgroundTint="@color/verde_fondo"
            android:text="@string/registrate"
            android:textAlignment="center"
            android:textColor="@color/blanco"
            android:textSize="35sp"
            android:layout_gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.589"
            app:strokeWidth="3dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            app:layout_constraintTop_toBottomOf="@+id/tvIntroText"
            app:strokeColor="@color/blanco"
            />

        <TextView
            android:id="@+id/buttonRegresar"
            android:layout_width="180dp"
            android:layout_height="22dp"
            android:fontFamily="serif"
            android:text="@string/cuenta"
            android:textAlignment="center"
            android:textColor="@color/negro"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="68dp"
            tools:layout_editor_absoluteY="594dp" />

        <TextView
            android:id="@+id/textRegistrologin"
            android:layout_width="108dp"
            android:layout_height="19dp"
            android:layout_marginEnd="44dp"
            android:layout_marginBottom="116dp"
            android:text="@string/inicio_Sesion"
            android:textColor="@color/verde_fondo"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </LinearLayout>



</ScrollView>

