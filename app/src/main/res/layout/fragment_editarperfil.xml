<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="40dp">

        <ImageView
            android:id="@+id/iv_foto_perfil"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ecosinletra"
            android:layout_marginBottom="12dp"
            android:clipToOutline="true"
            android:elevation="6dp"
            android:contentDescription="@string/perfil_foto_descripcion"
            android:scaleType="centerCrop"
            android:background="@drawable/imagen_borde_redondo"

            />

        <Button
            android:id="@+id/btn_cambiar_foto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/verde_fondo"
            android:text="@string/perfil_foto_descripcion"
            android:textColor="@color/blanco" />

        <EditText
            android:id="@+id/et_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nombre"
            android:background="@drawable/edit_text_rounded"
            android:padding="16dp"
            android:textColor="@color/negro"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/correo_electronico"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_text_rounded"
            android:padding="16dp"
            android:textColor="@color/negro"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/perfil_contraseña_hint"
            android:inputType="phone"
            android:background="@drawable/edit_text_rounded"
            android:padding="16dp"
            android:textColor="@color/negro"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_guardar"
            android:layout_width="220dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/verde_fondo"
            android:paddingVertical="12dp"
            android:text="@string/perfil_guardar_cambios"
            android:textColor="@color/blanco"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
