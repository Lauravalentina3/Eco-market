<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/inicioFragment">

    <fragment
        android:id="@+id/inicioFragment"
        android:name="com.EcoMarket.Fragments.InicioFragment"
        android:label="InicioFragment"
        android:layout="@layout/fragment_inicio">
        <action
            android:id="@+id/action_inicioFragment_to_rolFragment"
            app:destination="@id/rolFragment"
            app:popUpTo="@+id/inicioFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/rolFragment"
        android:name="com.EcoMarket.Fragments.RolFragment"
        android:label="RolFragment"
        android:layout="@layout/fragment_roles">
        <action
            android:id="@+id/action_rolFragment_to_homeFragment"
            app:destination="@id/homefragment"
            app:popUpTo="@+id/rolFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_rolFragment_to_loginFragment"
            app:destination="@id/loginFragmentMain"
            app:popUpTo="@+id/rolFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homefragment"
        android:name="com.EcoMarket.Fragments.HomeFragment"
        android:label="@string/home" />

    <fragment
        android:id="@+id/perfilfragment"
        android:name="com.EcoMarket.Fragments.PerfilUsuarioFragment"
        android:label="@string/perfil" >
        <action
            android:id="@+id/action_perfilUsuarioFragment_to_editarperfilfragment"
            app:destination="@id/editarperfilfragment" />
    </fragment>

    <fragment
        android:id="@+id/editarperfilfragment"
        android:name="com.EcoMarket.Fragments.EditarPerfilFragment"
        android:label="@string/editar_perfil" >
        <action
            android:id="@+id/action_editarPerfilFragment_to_perfilfragment"
            app:destination="@id/perfilfragment"
            app:popUpTo="@+id/perfilfragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/carritoFragment"
        android:name="com.EcoMarket.Fragments.CarritoFragment"
        android:label="@string/carrito" />

    <fragment
        android:id="@+id/productosFragment"
        android:name="com.EcoMarket.Fragments.ProductosFragment"
        android:label="@string/productos" />


    <fragment
        android:id="@+id/loginFragmentMain"
        android:name="com.EcoMarket.Fragments.LoginFragment"
        android:label="LoginFragment"
        android:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registroFragment"
            app:destination="@id/registroFragmentMain" />
        <action
            android:id="@+id/action_loginFragment_to_recuperacionContrasenaFragment"
            app:destination="@id/recuperacionContrasenaFragmentMain" />
        <action
            android:id="@+id/action_loginFragment_to_homefragment"
            app:destination="@id/homefragment" />
    </fragment>

    <fragment
        android:id="@+id/registroFragmentMain"
        android:name="com.EcoMarket.Fragments.RegistroFragment"
        android:label="RegistroFragment"
        android:layout="@layout/fragment_registro">
        <action
            android:id="@+id/action_registroFragment_to_loginFragment"
            app:destination="@id/loginFragmentMain"
            app:popUpTo="@+id/registroFragmentMain"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_registroFragment_to_recuperacionContrasenaFragment"
            app:destination="@id/recuperacionContrasenaFragmentMain"
            app:popUpTo="@+id/recuperacionContrasenaFragmentMain"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/recuperacionContrasenaFragmentMain"
        android:name="com.EcoMarket.Fragments.RecuperacionContrasenaFragment"
        android:label="RecuperacionContrasenaFragment"
        android:layout="@layout/fragment_recuperacion_contrasena" >
        <action
            android:id="@+id/action_recuperacionContrasenaFragment_to_loginFragment"
            app:destination="@id/loginFragmentMain"
            app:popUpTo="@+id/recuperacionContrasenaFragmentMain"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>